{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "shared_profile.schema.json",
  "title": "Shared Document Profile",
  "description": "Document identity and capability profile written by detector.py before extraction begins. Shared between procedure adapter and DTC adapter.",
  "type": "object",
  "required": [
    "schema_version",
    "schema_type",
    "document_id",
    "source_file",
    "metadata",
    "pdf_profile",
    "vehicle",
    "section",
    "structural_authority",
    "content_split",
    "processing"
  ],
  "additionalProperties": false,
  "properties": {

    "schema_version": {
      "type": "string",
      "const": "1.0"
    },

    "schema_type": {
      "type": "string",
      "const": "shared_document_profile"
    },

    "document_id": {
      "type": ["string", "null"],
      "description": "UUID assigned at detection time. Null only before detection runs."
    },

    "source_file": {
      "type": ["string", "null"],
      "description": "Original PDF filename e.g. ha.pdf"
    },

    "metadata": {
      "type": "object",
      "required": ["creator", "producer", "creation_date"],
      "properties": {
        "title":             { "type": ["string", "null"] },
        "author":            { "type": ["string", "null"] },
        "subject":           { "type": ["string", "null"] },
        "keywords":          { "type": ["string", "null"] },
        "creator":           { "type": ["string", "null"] },
        "producer":          { "type": ["string", "null"] },
        "format":            { "type": ["string", "null"] },
        "creation_date":     { "type": ["string", "null"] },
        "modification_date": { "type": ["string", "null"] },
        "encryption":        { "type": ["string", "null"] }
      }
    },

    "pdf_profile": {
      "type": "object",
      "required": ["is_digital", "needs_ocr", "pdf_type"],
      "properties": {
        "is_digital":         { "type": ["boolean", "null"] },
        "needs_ocr":          { "type": ["boolean", "null"] },
        "has_links":          { "type": ["boolean", "null"] },
        "has_internal_links": { "type": ["boolean", "null"] },
        "pdf_type":           {
          "type": ["string", "null"],
          "enum": ["digital", "scanned", null]
        },
        "link_count_sample":  { "type": ["integer", "null"] }
      }
    },

    "vehicle": {
      "type": "object",
      "required": ["make", "model", "year", "is_ev"],
      "properties": {
        "year":          { "type": ["string", "null"] },
        "make":          { "type": ["string", "null"] },
        "model":         { "type": ["string", "null"] },
        "variant":       { "type": ["string", "null"] },
        "revision_date": { "type": ["string", "null"] },
        "region":        { "type": ["string", "null"] },
        "is_ev":         { "type": ["boolean", "null"] },
        "source": {
          "type": "object",
          "properties": {
            "method":           { "type": ["string", "null"] },
            "pdf_page":         { "type": ["integer", "null"] },
            "page_ref":         { "type": ["string", "null"] },
            "make_from_lookup": { "type": ["boolean", "null"] },
            "confidence":       { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
          }
        }
      }
    },

    "section": {
      "type": "object",
      "required": ["code", "page_count"],
      "properties": {
        "code":              { "type": ["string", "null"] },
        "name":              { "type": ["string", "null"] },
        "manual_type":       { "type": ["string", "null"] },
        "page_count":        { "type": ["integer", "null"], "minimum": 1 },
        "page_ref_pattern":  { "type": ["string", "null"] },
        "page_ref_location": {
          "type": ["string", "null"],
          "enum": ["footer", "header", "full_page_scan", "sequential_fallback", null]
        }
      }
    },

    "structural_authority": {
      "type": "object",
      "required": ["primary_source"],
      "properties": {
        "primary_source": {
          "type": ["string", "null"],
          "enum": ["internal_outline", "visual_toc", "footer_pattern", "sequential", null]
        },
        "outline_available":   { "type": ["boolean", "null"] },
        "outline_entry_count": { "type": ["integer", "null"], "minimum": 0 },
        "fallback_chain": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "content_split": {
      "type": "object",
      "required": ["procedure_adapter", "dtc_adapter"],
      "properties": {
        "procedure_adapter": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "owner":        { "type": ["string", "null"] },
            "page_ranges": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["page_pdf_start", "page_pdf_end"],
                "properties": {
                  "page_pdf_start": { "type": "integer", "minimum": 1 },
                  "page_pdf_end":   { "type": "integer", "minimum": 1 }
                }
              }
            },
            "status": {
              "type": "string",
              "enum": ["pending", "completed", "failed"]
            }
          }
        },
        "dtc_adapter": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "owner":        { "type": ["string", "null"] },
            "page_ranges": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["page_pdf_start", "page_pdf_end"],
                "properties": {
                  "page_pdf_start": { "type": "integer", "minimum": 1 },
                  "page_pdf_end":   { "type": "integer", "minimum": 1 }
                }
              }
            },
            "status": {
              "type": "string",
              "enum": ["pending", "completed", "failed"]
            }
          }
        },
        "page_classification": {
          "type": "object",
          "description": "Per-page ownership map populated by splitter.py. Keys are string page_pdf numbers.",
          "additionalProperties": {
            "type": "string",
            "enum": ["procedure", "dtc", "mixed", "unknown"]
          }
        }
      }
    },

    "processing": {
      "type": "object",
      "required": ["procedure_extraction_completed", "dtc_extraction_completed"],
      "properties": {
        "manifest_created_at":            { "type": ["string", "null"] },
        "detection_completed_at":         { "type": ["string", "null"] },
        "procedure_extraction_completed": { "type": "boolean" },
        "dtc_extraction_completed":       { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["error"],
            "properties": {
              "batch": { "type": "string" },
              "error": { "type": "string" },
              "at":    { "type": "string" }
            }
          }
        }
      }
    }

  }
}