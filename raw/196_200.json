    {
      "text": "INSTALLATION",
      "page_pdf": 198,
      "page_manual": "EVB-198",
      "section_code": "EVB",
      "label": "section_header",
      "bbox": [
        52.14,
        341.70826718,
        132.11253378400002,
        331.56156166300553
      ]
    },
    {
      "text": "When replacing the Li-ion battery with a new battery, perform the work listed below.",
      "page_pdf": 198,
      "page_manual": "EVB-198",
      "section_code": "EVB",
      "label": "list_item",
      "bbox": [
        52.14,
        325.1359,
        456.47180399999934,
        315.8923124640884
      ]
    },
    {
      "text": "Enter the date of the (replacement) work on the EV battery tracking identification seal that is packaged together with the new part.",
      "page_pdf": 198,
      "page_manual": "EVB-198",
      "section_code": "EVB",
      "label": "list_item",
      "bbox": [
        52.14,
        310.6160524,
        558.5059955999996,
        289.9124768640884
      ]
    },
    {
      "text": "Cut the EV battery tracking identification seal into 2 pieces and apply them to the body of the replaced (old) Li-ion battery and to the 'Li-ion battery replacement history record'.",
      "page_pdf": 198,
      "page_manual": "EVB-198",
      "section_code": "EVB",
      "label": "list_item",
      "bbox": [
        52.139895599999974,
        284.6362168,
        558.4965995999997,
        263.8732376640884
      ]
    },
    {
      "text": "Enter the necessary information in the 'Li-ion battery replacement history record'.",
      "page_pdf": 198,
      "page_manual": "EVB-198",
      "section_code": "EVB",
      "label": "list_item",
      "bbox": [
        52.1398956,
        258.65638119999994,
        448.39635959999936,
        249.41279366408844
      ]
    },
    {
      "text": "Install the locating pin [SST: KV99111300 (J-50306)] in the position on the body as shown in the figure.",
      "page_pdf": 198,
      "page_manual": "EVB-198",
      "section_code": "EVB",
      "label": "list_item",
      "bbox": [
        52.1398956,
        242.51603679999994,
        558.4757195999997,
        233.27244926408844
      ]
