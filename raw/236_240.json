        71.00932
      ]
    },
    {
      "text": "LI-ION BATTERY",
      "page_pdf": 240,
      "page_manual": "EVB-240",
      "section_code": "EVB",
      "label": "section_header",
      "bbox": [
        251.87999,
        769.00991,
