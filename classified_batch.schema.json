{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "classified_batch.schema.json",
  "title": "Classified Batch",
  "description": "Output of classifier.py. Same structure as raw_batch but every element has been tagged with type, safety_level, and ownership signals. Tables have been cleaned and repaired.",
  "type": "object",
  "required": [
    "schema_version",
    "schema_type",
    "document_id",
    "section_code",
    "batch",
    "page_map",
    "text_elements",
    "tables",
    "images"
  ],
  "additionalProperties": false,
  "properties": {

    "schema_version": { "type": "string", "const": "2.0" },
    "schema_type":    { "type": "string", "const": "classified_batch" },
    "document_id":    { "type": "string", "minLength": 1 },
    "manufacturer":   { "type": ["string", "null"] },
    "model":          { "type": ["string", "null"] },
    "year":           { "type": ["string", "null"] },
    "section_code":   { "type": ["string", "null"] },

    "batch": {
      "type": "object",
      "required": ["page_start_pdf", "page_end_pdf", "ocr_used", "tableformer_used", "extracted_at"],
      "properties": {
        "page_start_pdf":    { "type": "integer", "minimum": 1 },
        "page_end_pdf":      { "type": "integer", "minimum": 1 },
        "ocr_used":          { "type": "boolean" },
        "tableformer_used":  { "type": "boolean" },
        "extracted_at":      { "type": "string" },
        "classified_at":     { "type": ["string", "null"] },
        "extraction_errors": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "page_map": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["page_pdf", "is_scanned", "rotation_degrees", "width_pts", "height_pts"],
        "properties": {
          "page_pdf":               { "type": "integer", "minimum": 1 },
          "page_manual":            { "type": ["string", "null"] },
          "page_manual_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "page_manual_source":     { "type": ["string", "null"] },
          "section_code":           { "type": ["string", "null"] },
          "is_scanned":             { "type": "boolean" },
          "rotation_degrees":       { "type": "integer" },
          "width_pts":              { "type": "number" },
          "height_pts":             { "type": "number" },
          "footer_text_raw":        { "type": ["string", "null"] },
          "header_text_raw":        { "type": ["string", "null"] },
          "dtc_score":              {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1,
            "description": "DTC confidence score assigned by splitter.py"
          },
          "content_owner": {
            "type": ["string", "null"],
            "enum": ["procedure_adapter", "dtc_adapter", "mixed", null],
            "description": "Ownership assigned by splitter.py"
          }
        }
      }
    },

    "text_elements": {
      "type": "array",
      "description": "Tagged text elements. Noise removed. type and safety_level added to every element.",
      "items": {
        "type": "object",
        "required": [
          "element_id", "text", "page_pdf",
          "bbox", "bbox_coordinate_system",
          "docling_label", "type", "safety_level"
        ],
        "properties": {
          "element_id":  { "type": "string" },
          "text":        { "type": "string" },
          "page_pdf":    { "type": ["integer", "null"] },
          "page_manual": { "type": ["string", "null"] },
          "section_code":{ "type": ["string", "null"] },
          "bbox": {
            "type": ["array", "null"],
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          },
          "bbox_coordinate_system": { "type": "string", "enum": ["docling", "pymupdf"] },
          "font_name":     { "type": ["string", "null"] },
          "font_size":     { "type": ["number", "null"] },
          "is_bold":       { "type": ["boolean", "null"] },
          "is_italic":     { "type": ["boolean", "null"] },
          "reading_order": { "type": ["integer", "null"] },
          "docling_label": { "type": ["string", "null"] },
          "type": {
            "type": "string",
            "enum": [
              "section_header",
              "procedure_step",
              "warning",
              "warning_header",
              "note",
              "general_text",
              "spec_value"
            ]
          },
          "safety_level": {
            "type": "string",
            "enum": ["HIGH_VOLTAGE", "WARNING", "CAUTION", "NONE"]
          },
          "is_dtc":        { "type": ["boolean", "null"] },
          "content_owner": {
            "type": ["string", "null"],
            "enum": ["procedure_adapter", "dtc_adapter", null]
          }
        }
      }
    },

    "tables": {
      "type": "array",
      "description": "Cleaned and repaired tables. data field is the cleaned version. data_raw preserves original.",
      "items": {
        "type": "object",
        "required": [
          "table_id", "page_pdf",
          "bbox", "bbox_coordinate_system",
          "num_rows", "num_cols",
          "tableformer_used",
          "table_type",
          "data", "data_raw", "markdown"
        ],
        "properties": {
          "table_id":               { "type": "string" },
          "page_pdf":               { "type": ["integer", "null"] },
          "page_manual":            { "type": ["string", "null"] },
          "section_code":           { "type": ["string", "null"] },
          "bbox": {
            "type": ["array", "null"],
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          },
          "bbox_coordinate_system": { "type": "string", "enum": ["docling", "pymupdf"] },
          "num_rows":               { "type": "integer", "minimum": 0 },
          "num_cols":               { "type": "integer", "minimum": 0 },
          "tableformer_used":       { "type": "boolean" },
          "table_type": {
            "type": "string",
            "enum": ["general", "spec_table", "index_table", "toc", "dtc_index", "empty"]
          },
          "pages_merged": {
            "type": ["array", "null"],
            "items": { "type": "string" },
            "description": "Page refs if this table was merged from multiple pages"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "data_raw": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "markdown":    { "type": "string" },
          "is_dtc":      { "type": ["boolean", "null"] },
          "content_owner": {
            "type": ["string", "null"],
            "enum": ["procedure_adapter", "dtc_adapter", null]
          }
        }
      }
    },

    "images": {
      "type": "array",
      "description": "Images with subtype added by classifier.",
      "items": {
        "type": "object",
        "required": [
          "image_id", "file", "format_saved",
          "page_pdf", "type", "subtype", "bbox_coordinate_system"
        ],
        "properties": {
          "image_id":               { "type": "string" },
          "file":                   { "type": "string" },
          "format_original":        { "type": ["string", "null"] },
          "format_saved":           { "type": "string", "const": "png" },
          "page_pdf":               { "type": ["integer", "null"] },
          "page_manual":            { "type": ["string", "null"] },
          "section_code":           { "type": ["string", "null"] },
          "bbox":                   {
            "type": ["array", "null"],
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          },
          "bbox_coordinate_system": { "type": "string", "enum": ["pymupdf"] },
          "bbox_resolved":          { "type": ["boolean", "null"] },
          "width_px":               { "type": ["integer", "null"] },
          "height_px":              { "type": ["integer", "null"] },
          "type":    { "type": "string", "enum": ["raster", "vector"] },
          "subtype": {
            "type": ["string", "null"],
            "enum": ["safety_icon", "exploded_view", "diagram", "connector_view", null]
          },
          "caption_raw":    { "type": ["string", "null"] },
          "image_ref_code": { "type": ["string", "null"] },
          "content_owner": {
            "type": ["string", "null"],
            "enum": ["procedure_adapter", "dtc_adapter", null]
          }
        }
      }
    }

  }
}