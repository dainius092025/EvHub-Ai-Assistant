{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "classified_batch.schema.json",
  "title": "Classified Batch",
  "description": "Output of classifier.py. All raw batches merged into one file. Elements are tagged with type and safety_level. Tables are cleaned: data_raw is consumed and removed; the cleaned form is split into headers (first row) + data (repaired body rows). image_refs lists reference codes extracted from table cells.",
  "type": "object",
  "required": [
    "schema_version",
    "schema_type",
    "document_id",
    "section_code",
    "batch",
    "text_elements",
    "tables",
    "images"
  ],
  "additionalProperties": false,
  "properties": {

    "schema_version": { "type": "string", "const": "2.0" },
    "schema_type":    { "type": "string", "const": "classified_batch" },
    "document_id":    { "type": "string", "minLength": 1 },
    "section_code":   { "type": ["string", "null"] },

    "batch": {
      "type": "object",
      "required": ["total_pages", "ocr_used", "classified_at", "source_batches"],
      "properties": {
        "total_pages": {
          "type": "integer",
          "minimum": 0,
          "description": "Total PDF pages across all merged batches."
        },
        "ocr_used": {
          "type": "boolean",
          "description": "True if any batch was extracted via OCR."
        },
        "classified_at": {
          "type": "string",
          "description": "ISO 8601 timestamp when classification completed."
        },
        "source_batches": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Filenames of the raw batch files merged into this output."
        }
      }
    },

    "text_elements": {
      "type": "array",
      "description": "Tagged text elements. Noise removed. type and safety_level added to every element.",
      "items": {
        "type": "object",
        "required": [
          "element_id", "text", "page_pdf",
          "bbox", "bbox_coordinate_system",
          "docling_label", "type", "safety_level"
        ],
        "properties": {
          "element_id":  { "type": "string" },
          "text":        { "type": "string" },
          "page_pdf":    { "type": ["integer", "null"] },
          "page_manual": { "type": ["string", "null"] },
          "section_code":{ "type": ["string", "null"] },
          "bbox": {
            "type": ["array", "null"],
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          },
          "bbox_coordinate_system": {
            "type": "string",
            "enum": ["docling", "pymupdf"]
          },
          "font_name":     { "type": ["string", "null"] },
          "font_size":     { "type": ["number", "null"] },
          "is_bold":       { "type": ["boolean", "null"] },
          "is_italic":     { "type": ["boolean", "null"] },
          "reading_order": { "type": ["integer", "null"] },
          "docling_label": {
            "type": ["string", "null"],
            "description": "Raw Docling structural label (e.g. section_header, list_item)."
          },
          "label": {
            "type": ["string", "null"],
            "description": "Docling DocItemLabel enum value. Preserved from extractor output."
          },
          "type": {
            "type": "string",
            "description": "Semantic type assigned by classifier.py _classify_type().",
            "enum": [
              "warning",
              "note",
              "header",
              "procedure_step",
              "specification",
              "body"
            ]
          },
          "safety_level": {
            "type": "string",
            "description": "Highest safety signal found in element text.",
            "enum": ["HIGH_VOLTAGE", "WARNING", "CAUTION", "NONE"]
          }
        }
      }
    },

    "tables": {
      "type": "array",
      "description": "Cleaned and repaired tables. data_raw has been consumed and is not present. headers is the first row; data is the forward-fill-repaired body. markdown is the Markdown rendering.",
      "items": {
        "type": "object",
        "required": [
          "table_id", "page_pdf",
          "bbox", "bbox_coordinate_system",
          "num_rows", "num_cols",
          "tableformer_used",
          "table_type",
          "headers", "data", "markdown"
        ],
        "properties": {
          "table_id":               { "type": "string" },
          "page_pdf":               { "type": ["integer", "null"] },
          "page_manual":            { "type": ["string", "null"] },
          "section_code":           { "type": ["string", "null"] },
          "bbox": {
            "type": ["array", "null"],
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          },
          "bbox_coordinate_system": {
            "type": "string",
            "enum": ["docling", "pymupdf"]
          },
          "num_rows":               { "type": "integer", "minimum": 0 },
          "num_cols":               { "type": "integer", "minimum": 0 },
          "tableformer_used":       { "type": "boolean" },
          "continues_on_next_page": { "type": ["boolean", "null"] },
          "continued_from_prev":    { "type": ["boolean", "null"] },
          "table_type": {
            "type": "string",
            "description": "Assigned by classifier.py _classify_table(). toc=table-of-contents page, dtc=diagnostic trouble code table, general=everything else.",
            "enum": ["general", "toc", "dtc"]
          },
          "headers": {
            "type": "array",
            "items": { "type": "string" },
            "description": "First row of the original table, used as column headers."
          },
          "data": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "string" }
            },
            "description": "Body rows after forward-fill cell repair. Does not include the header row."
          },
          "markdown": {
            "type": "string",
            "description": "Markdown rendering of the table from Docling."
          },
          "image_refs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Unique image reference codes (e.g. AC359A) extracted from table cell text."
          },
          "is_dtc": { "type": ["boolean", "null"] },
          "content_owner": {
            "type": ["string", "null"],
            "enum": ["cars_adapter", "dtc_adapter", null],
            "description": "Set to cars_adapter by classifier. dtc_adapter after splitter.py routes DTC tables."
          }
        }
      }
    },

    "images": {
      "type": "array",
      "description": "Images with subtype classified by pixel dimensions.",
      "items": {
        "type": "object",
        "required": [
          "image_id", "file", "format_saved",
          "page_pdf", "type", "subtype", "bbox_coordinate_system"
        ],
        "properties": {
          "image_id":               { "type": "string" },
          "file": {
            "type": "string",
            "pattern": "^images/",
            "description": "Relative path to the saved PNG file."
          },
          "format_original":        { "type": ["string", "null"] },
          "format_saved":           { "type": "string", "const": "png" },
          "page_pdf":               { "type": ["integer", "null"] },
          "page_manual":            { "type": ["string", "null"] },
          "section_code":           { "type": ["string", "null"] },
          "bbox": {
            "type": ["array", "null"],
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          },
          "bbox_coordinate_system": { "type": "string", "enum": ["pymupdf"] },
          "bbox_resolved":          { "type": ["boolean", "null"] },
          "width_px":               { "type": ["integer", "null"], "minimum": 0 },
          "height_px":              { "type": ["integer", "null"], "minimum": 0 },
          "type": {
            "type": "string",
            "enum": ["raster", "vector"]
          },
          "subtype": {
            "type": ["string", "null"],
            "description": "Assigned by classifier.py based on pixel dimensions. connector_view is reserved for future use.",
            "enum": ["safety_icon", "exploded_view", "diagram", "connector_view", null]
          },
          "caption_raw":    { "type": ["string", "null"] },
          "image_ref_code": { "type": ["string", "null"] },
          "content_owner": {
            "type": ["string", "null"],
            "enum": ["cars_adapter", "dtc_adapter", null],
            "description": "Set to cars_adapter by classifier. dtc_adapter after splitter.py routes DTC images."
          }
        }
      }
    }

  }
}
