    },
    {
      "text": "There is the danger of electric shock caused by contact with the terminals. Be sure to wear insulated protective gear and use insulated tools.",
      "page_pdf": 251,
      "page_manual": "EVB-251",
      "section_code": "EVB",
      "label": "list_item",
      "bbox": [
