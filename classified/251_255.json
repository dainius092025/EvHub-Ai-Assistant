        469.1363384,
        559.8318699999996,
        448.3733592640884
      ],
      "type": "procedure_step",
      "safety_level": "HIGH_VOLTAGE"
    },
    {
      "text": "This work must not be performed by multiple operators because there is a risk of electric shock if the operators contact one another.",
      "page_pdf": 251,
      "page_manual": "EVB-251",
      "section_code": "EVB",
      "label": "list_item",
