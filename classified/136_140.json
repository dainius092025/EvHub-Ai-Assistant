      "type": "section_header",
      "safety_level": "NONE"
    },
    {
      "text": "Is the inspection result normal?",
      "page_pdf": 137,
      "page_manual": "EVB-137",
      "section_code": "EVB",
      "label": "text",
      "bbox": [
        53.46001,
        131.57592,
        198.38673280000006,
        122.33233246408838
      ],
      "type": "general_text",
      "safety_level": "NONE"
    },
    {
      "text": "YES >> GO TO 4.",
      "page_pdf": 137,
      "page_manual": "EVB-137",
      "section_code": "EVB",
      "label": "text",
      "bbox": [
        59.10001,
        117.05601999999999,
        155.30461,
        107.81243246408837
      ],
      "type": "general_text",
      "safety_level": "NONE"
    },
    {
      "text": "NO >> Repair harness or connector.",
      "page_pdf": 137,
      "page_manual": "EVB-137",
      "section_code": "EVB",
      "label": "text",
      "bbox": [
        59.10001,
        105.53662840000004,
        244.3076979999998,
        96.29304086408843
      ],
      "type": "general_text",
      "safety_level": "NONE"
    },
    {
      "text": "4.CHECK MODULE VOLTAGE",
      "page_pdf": 137,
      "page_manual": "EVB-137",
      "section_code": "EVB",
      "label": "text",
      "bbox": [
        52.44,
        94.46401000000003,
        202.51814879999998,
        78.52679011049725
      ],
      "type": "general_text",
      "safety_level": "NONE"
    },
    {
      "text": "Check voltage of corresponding module. Refer to EVB-138, \"Component Inspection\". Is the inspection result normal?",
      "page_pdf": 137,
      "page_manual": "EVB-137",
      "section_code": "EVB",
      "label": "text",
      "bbox": [
