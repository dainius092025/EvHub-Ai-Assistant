      ],
      "type": "section_header",
      "safety_level": "NONE"
    },
    {
      "text": "1.PERFORM DTC CONFIRMATION PROCEDURE",
      "page_pdf": 139,
      "page_manual": "EVB-139",
      "section_code": "EVB",
      "label": "list_item",
      "bbox": [
        52.44,
        440.364,
        296.998896,
        424.42678011049725
      ],
      "type": "procedure_step",
      "safety_level": "NONE"
    },
    {
      "text": "With CONSULT",
      "page_pdf": 139,
      "page_manual": "EVB-139",
      "section_code": "EVB",
      "label": "section_header",
      "bbox": [
        64.980336,
        415.5562524,
        138.10126079999998,
        406.3126648640884
      ],
      "type": "section_header",
      "safety_level": "NONE"
    },
    {
      "text": "Power switch ON and wait for 10 seconds or more.",
      "page_pdf": 139,
      "page_manual": "EVB-139",
      "section_code": "EVB",
      "label": "list_item",
      "bbox": [
        53.460944399999995,
        404.0368608,
        308.8233444000003,
        394.7932732640884
      ],
      "type": "procedure_step",
      "safety_level": "NONE"
    },
    {
      "text": "Select 'Self Diagnostic Result' of 'HV BAT'.",
      "page_pdf": 139,
      "page_manual": "EVB-139",
      "section_code": "EVB",
      "label": "list_item",
      "bbox": [
        53.460944399999995,
        392.5768728,
        276.0449807999998,
        383.3332852640884
      ],
      "type": "procedure_step",
      "safety_level": "HIGH_VOLTAGE"
    },
    {
      "text": "Check DTC.",
      "page_pdf": 139,
      "page_manual": "EVB-139",
      "section_code": "EVB",
      "label": "list_item",
      "bbox": [
        53.460944399999995,
        381.0563328,
        130.29944880000005,
        371.8127452640884
      ],
      "type": "procedure_step",
      "safety_level": "NONE"
    },
    {
      "text": "Is any DTC detected?",
      "page_pdf": 139,
      "page_manual": "EVB-139",
      "section_code": "EVB",
      "label": "section_header",
      "bbox": [
        53.460944399999995,
        366.5364852,
        154.7084820000001,
        357.2928976640884
      ],
      "type": "section_header",
      "safety_level": "NONE"
    },
    {
      "text": "YES >> Refer to EVB-146, \"Diagnosis Procedure\".",
      "page_pdf": 139,
      "page_manual": "EVB-139",
      "section_code": "EVB",
      "label": "text",
      "bbox": [
        59.10001,
        352.07591,
        305.48231,
        342.8323224640884
      ],
      "type": "general_text",
      "safety_level": "NONE"
    },
    {
      "text": "NO >> INSPECTION END",
      "page_pdf": 139,
      "page_manual": "EVB-139",
      "section_code": "EVB",
      "label": "text",
      "bbox": [
        59.100293600000015,
