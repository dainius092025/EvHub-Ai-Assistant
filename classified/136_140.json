      ],
      "type": "section_header",
      "safety_level": "NONE"
    },
    {
      "text": "Perform 'All DTC Reading' with CONSULT.",
      "page_pdf": 136,
      "page_manual": "EVB-136",
      "section_code": "EVB",
      "label": "list_item",
      "bbox": [
        52.14,
        735.83589,
        272.38798199999997,
        726.5923024640884
      ],
      "type": "procedure_step",
      "safety_level": "NONE"
    },
    {
      "text": "Check systems other than 'HV BAT' if any DTC is detected.",
      "page_pdf": 136,
      "page_manual": "EVB-136",
      "section_code": "EVB",
      "label": "list_item",
      "bbox": [
        52.14,
        724.3164984,
        351.56431560000004,
        715.0729108640885
      ],
      "type": "procedure_step",
      "safety_level": "HIGH_VOLTAGE"
    },
    {
      "text": "Is any DTC detected?",
      "page_pdf": 136,
      "page_manual": "EVB-136",
      "section_code": "EVB",
      "label": "section_header",
      "bbox": [
        52.14,
        709.8560544,
        153.27645600000002,
        700.6124668640884
      ],
      "type": "section_header",
      "safety_level": "NONE"
    },
    {
      "text": "YES >> After performing trouble diagnosis of detected DTC, GO TO 2.",
      "page_pdf": 136,
      "page_manual": "EVB-136",
      "section_code": "EVB",
      "label": "list_item",
      "bbox": [
        57.84,
        695.33589,
        395.75669999999985,
        686.0923024640884
      ],
      "type": "procedure_step",
      "safety_level": "NONE"
    },
    {
      "text": "NO >> GO TO 2.",
      "page_pdf": 136,
      "page_manual": "EVB-136",
      "section_code": "EVB",
      "label": "list_item",
      "bbox": [
        57.84,
        683.8164984,
        154.05410039999992,
        674.5729108640885
      ],
      "type": "procedure_step",
      "safety_level": "NONE"
    },
    {
      "text": "2.PRECONDITIONING",
      "page_pdf": 136,
      "page_manual": "EVB-136",
      "section_code": "EVB",
      "label": "list_item",
      "bbox": [
        52.14,
        672.74407,
        165.98800799999998,
        656.8068501104972
      ],
      "type": "procedure_step",
      "safety_level": "NONE"
    },
    {
      "text": "WARNING: Disconnect high voltage. Refer to GI-33, \"How to Disconnect High Voltage\".",
      "page_pdf": 136,
      "page_manual": "EVB-136",
      "section_code": "EVB",
      "label": "section_header",
      "bbox": [
        52.139808,
        646.4956023999999,
        106.18977600000001,
        637.2520148640884
      ],
      "type": "warning",
      "safety_level": "HIGH_VOLTAGE"
    },
    {
      "text": "Remove Li-ion battery. Refer to EVB-194, \"Removal and Installation\".",
      "page_pdf": 136,
      "page_manual": "EVB-136",
      "section_code": "EVB",
      "label": "list_item",
      "bbox": [
        52.14037200000001,
        623.515912,
        392.06232,
        614.2722924640884
      ],
      "type": "procedure_step",
      "safety_level": "NONE"
    },
    {
      "text": "Remove battery pack upper case. Refer to EVB-204, \"BATTERY PACK UPPER CASE : Removal and Installation\".",
      "page_pdf": 136,
      "page_manual": "EVB-136",
      "section_code": "EVB",
      "label": "list_item",
      "bbox": [
        52.140096000000085,
        611.9953399999999,
        558.5183063999997,
        591.2323124640884
      ],
      "type": "procedure_step",
      "safety_level": "HIGH_VOLTAGE"
    },
    {
      "text": ">> GO TO 3.",
      "page_pdf": 136,
      "page_manual": "EVB-136",
      "section_code": "EVB",
      "label": "text",
      "bbox": [
        93.7796556,
        571.4956083999999,
        154.05301200000002,
        562.2520208640884
      ],
      "type": "general_text",
      "safety_level": "NONE"
    },
    {
      "text": "3.CHECK HARNESS BETWEEN MODULE AND LI-ION BATTERY CONTROLLER",
      "page_pdf": 136,
      "page_manual": "EVB-136",
      "section_code": "EVB",
      "label": "section_header",
      "bbox": [
        52.14,
        560.424,
        443.0860704000004,
        544.4867801104972
      ],
      "type": "section_header",
      "safety_level": "NONE"
    },
    {
      "text": "Disconnect voltage detection terminal of bus bar and Li-ion battery controller harness connector.",
      "page_pdf": 136,
      "page_manual": "EVB-136",
      "section_code": "EVB",
      "label": "list_item",
      "bbox": [
        52.13959919999999,
        537.1759883999999,
        516.3103512000009,
        527.9324008640884
      ],
      "type": "procedure_step",
      "safety_level": "NONE"
    },
    {
      "text": "Refer to below table and check the continuity between Li-ion battery controller and corresponding bus bar .",
      "page_pdf": 136,
      "page_manual": "EVB-136",
      "section_code": "EVB",
      "label": "list_item",
      "bbox": [
        52.13959919999999,
        524.6960124,
        558.4628951999999,
        503.0319568640884
      ],
      "type": "procedure_step",
      "safety_level": "NONE"
    },
    {
