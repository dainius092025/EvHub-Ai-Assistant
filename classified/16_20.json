    {
      "text": "Four laminated cells are integrated into one module.",
      "page_pdf": 17,
      "page_manual": "EVB-17",
      "section_code": "EVB",
      "label": "list_item",
      "bbox": [
        53.46001,
        650.33589,
        303.3050787999999,
        641.0923024640884
      ],
      "type": "procedure_step",
      "safety_level": "NONE"
    },
    {
      "text": "The Li-ion battery is equipped with 48 modules.",
      "page_pdf": 17,
      "page_manual": "EVB-17",
      "section_code": "EVB",
      "label": "list_item",
      "bbox": [
        53.46001,
        638.875902,
        281.18532880000004,
        629.6323144640885
      ],
      "type": "procedure_step",
      "safety_level": "NONE"
    },
    {
      "text": "There are two kinds of modules, according to the location of positive and negative terminals.",
      "page_pdf": 17,
      "page_manual": "EVB-17",
